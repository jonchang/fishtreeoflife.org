---
// A titled page: <h1> plus content. Ported from the Jekyll _layouts/page.html.
// Use it as a Markdown `layout:` (title/description/image come from front
// matter) or as a component with the same props.
import Base from './Base.astro';

interface PageMeta {
  title: string;
  description?: string | undefined;
  image?: string | undefined;
}

type Props = PageMeta | { frontmatter: PageMeta };

const meta: PageMeta = 'frontmatter' in Astro.props ? Astro.props.frontmatter : Astro.props;
---

<Base title={meta.title} description={meta.description} image={meta.image}>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title">{meta.title}</h1>
    </header>

    <div class="post-content">
      <slot />
    </div>
  </article>
</Base>
